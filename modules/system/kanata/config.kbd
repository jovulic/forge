;; docs: https://github.com/jtroo/kanata/blob/main/docs/config.adoc

(defcfg
  ;; In Kanata, if you want keys NOT listed in defsrc to work normally,
  ;; you must set this to yes.
  process-unmapped-keys yes

  ;; Intercept the Corsair Scimitar mouse side buttons and the physical keyboard
  ;; (so Kanata can detect when Alt is held on the keyboard while pressing mouse
  ;; side buttons). With process-unmapped-keys yes, all unmapped keyboard keys
  ;; pass through untouched.
  linux-dev-names-include (
    "Corsair CORSAIR SCIMITAR RGB ELITE Gaming Mouse Keyboard"
    "DZTECH DZ60RGB_ANSI"
    "DZTECH DZ60RGB_ANSI Keyboard"
  )
  linux-continue-if-no-devs-found yes
)

(defsrc
  ;; Define the 12 mouse side buttons in physical order: 1 to 12.
  ;; Corresponds to keys: 1 2 3 4 5 6 7 8 9 0 - +.
  kp1 kp2 kp3
  kp4 kp5 kp6
  kp7 kp8 kp9
  kp0 kp- kp+
)

(defalias
  move-up (macro
    (movemouse-up 1 20) 10
    (movemouse-up 1 20) 10
    (movemouse-up 1 20) 10
    (movemouse-up 1 20) 10
    (movemouse-up 1 20) 10
    (movemouse-up 1 20) 10
    (movemouse-up 1 20) 10
    (movemouse-up 1 20) 10
    (movemouse-up 1 20) 10
    (movemouse-up 1 20) 10
    (movemouse-up 1 20) 10
    (movemouse-up 1 20) 10
    (movemouse-up 1 20) 10
    (movemouse-up 1 20) 10
    (movemouse-up 1 20) 10
    (movemouse-up 1 20) 10
    (movemouse-up 1 20) 10
    (movemouse-up 1 20) 10
    (movemouse-up 1 20) 10
    (movemouse-up 1 20) 10
    (movemouse-up 1 20) 10
  )

  move-left (macro
    (movemouse-left 1 20) 10
    (movemouse-left 1 20) 10
    (movemouse-left 1 20) 10
    (movemouse-left 1 20) 10
    (movemouse-left 1 20) 10
    (movemouse-left 1 20) 10
    (movemouse-left 1 20) 10
    (movemouse-left 1 20) 10
    (movemouse-left 1 20) 10
    (movemouse-left 1 20) 10
    (movemouse-left 1 20) 10
    (movemouse-left 1 20) 10
    (movemouse-left 1 20) 10
    (movemouse-left 1 20) 10
    (movemouse-left 1 20) 10
    (movemouse-left 1 20) 10
    (movemouse-left 1 20) 10
    (movemouse-left 1 20) 10
    (movemouse-left 1 20) 10
    (movemouse-left 1 20) 10
    (movemouse-left 1 20) 10
  )

  move-down (macro
    (movemouse-down 1 20) 10
    (movemouse-down 1 20) 10
    (movemouse-down 1 20) 10
    (movemouse-down 1 20) 10
    (movemouse-down 1 20) 10
    (movemouse-down 1 20) 10
    (movemouse-down 1 20) 10
    (movemouse-down 1 20) 10
    (movemouse-down 1 20) 10
    (movemouse-down 1 20) 10
    (movemouse-down 1 20) 10
    (movemouse-down 1 20) 10
    (movemouse-down 1 20) 10
    (movemouse-down 1 20) 10
    (movemouse-down 1 20) 10
    (movemouse-down 1 20) 10
    (movemouse-down 1 20) 10
    (movemouse-down 1 20) 10
    (movemouse-down 1 20) 10
    (movemouse-down 1 20) 10
    (movemouse-down 1 20) 10
  )

  move-right (macro
    (movemouse-right 1 20) 10
    (movemouse-right 1 20) 10
    (movemouse-right 1 20) 10
    (movemouse-right 1 20) 10
    (movemouse-right 1 20) 10
    (movemouse-right 1 20) 10
    (movemouse-right 1 20) 10
    (movemouse-right 1 20) 10
    (movemouse-right 1 20) 10
    (movemouse-right 1 20) 10
    (movemouse-right 1 20) 10
    (movemouse-right 1 20) 10
    (movemouse-right 1 20) 10
    (movemouse-right 1 20) 10
    (movemouse-right 1 20) 10
    (movemouse-right 1 20) 10
    (movemouse-right 1 20) 10
    (movemouse-right 1 20) 10
    (movemouse-right 1 20) 10
    (movemouse-right 1 20) 10
  )

  ;; Send F4 normally (including with Shift or Ctrl), but send [ when Left/Right
  ;; Alt is held so that Alt + Mouse Button 4 sends Alt+[ instead of Alt+F4
  ;; (avoiding Alt+F4 exit shortcut).
  f4-safe (fork F4 [ (lalt ralt))
)

(deflayer default
  ;; Default behavior (standard number row 1 to =).
  1 2 3
  4 5 6
  7 8 9
  0 - =
)

(deflayer kcd2
  ;; KCD2 Mouse Movement Macros (mapped to mouse buttons 8, 10, 11, 12 in order).
  ;; Mouse buttons 1-7, 9 are unaffected.
  kp1 kp2 kp3
  kp4 kp5 kp6
  kp7 @move-up kp9
  @move-left @move-down @move-right
)

(deflayer wow
  ;; 12 Side buttons map to function keys (with F4 forked to [ when Alt is held).
  F1       F2  F3
  @f4-safe F5  F6
  F7       F8  F9
  F10      F11 F12
)
