+        let mut flags = xr::sys::InputSourceLocalizedNameFlags::EMPTY;
+        if string_sections_to_include & VR_INPUT_STRING_HAND != 0 {
+            flags |= xr::sys::InputSourceLocalizedNameFlags::USER_PATH;
