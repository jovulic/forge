+    assert_eq!(err, vr::EVRInputError::None);
+    let bound: Vec<u64> = origins.iter().copied().filter(|&o| o != 0).collect();
+    assert_eq!(bound.len(), 2, "expected two origins, got {origins:?}");
+    // Unused entries stay invalid
